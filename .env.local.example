# ============================================================
# LLM Conclave — Environment Variables
# Copy this file to .env.local and fill in your values.
# ============================================================

# ---- Operating Mode ----------------------------------------
# Set to "true" for SaaS mode (auth + credits + Stripe)
# Set to "false" or omit for open-source BYOK mode
SAAS_MODE=false
NEXT_PUBLIC_SAAS_MODE=false

# ---- App URL -----------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Preset Model API Keys ---------------------------------
# A preset model only appears in the UI if its env var is set.
# Keys are server-side only — never sent to the browser.
OPENROUTER_API_KEY=
DOUBAO_API_KEY=

# ---- Redis (optional) --------------------------------------
# Required for multi-instance deployments (Railway, etc.)
# Set REDIS_DISABLED=true to use in-memory store (single-instance only)
REDIS_DISABLED=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Pipeline Health Check (daily + post-deploy) -----------
# Secret protecting GET /api/health/pipeline (header x-health-secret or ?secret=)
HEALTH_CHECK_SECRET=
# Webhook for failure/recovery alerts. Feishu/DingTalk/WeCom/Slack/Telegram/Bark
# URLs are auto-formatted; any other endpoint gets {"text": "..."}.
# Leave empty to skip the webhook channel.
PIPELINE_ALERT_WEBHOOK=
# Email channel via Resend (https://resend.com) — independent from the webhook.
# Both must be set for email alerts; leave both empty to skip.
RESEND_API_KEY=
PIPELINE_ALERT_EMAIL=
# Optional sender address. Default: resend.dev testing sender (only delivers to
# your own Resend account email). Production: use an address on your verified domain.
PIPELINE_ALERT_EMAIL_FROM=

# ============================================================
# The variables below are only needed when SAAS_MODE=true
# ============================================================

# ---- Supabase ----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server-side only, used for credit deduction

# ---- Stripe ------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create products in Stripe Dashboard first)
STRIPE_PRICE_STARTER=price_...   # 1,000 credits / $1
STRIPE_PRICE_BASIC=price_...     # 5,000 credits / $4
STRIPE_PRICE_PRO=price_...       # 20,000 credits / $14
